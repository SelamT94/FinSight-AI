# Chat — vLLM (same stack as cbe-ai-assistant: host :5000 → /v1/chat/completions)
# Either set OPENAI_COMPAT_BASE_URL + LLAMA_MODEL/MISTRAL_MODEL, or reuse cbe vars:
#   VLLM_BASE_URL=http://localhost:5000
#   VLLM_CHAT_MODEL=TheBloke/Mistral-7B-Instruct-v0.2-GPTQ
LLM_BACKEND=vllm
OPENAI_COMPAT_BASE_URL=http://localhost:5000/v1
MISTRAL_BASE_URL=http://localhost:5000/v1
LLAMA_BASE_URL=http://localhost:5003/v1
QWEN_BASE_URL=http://localhost:5002/v1
LLAMA_MODEL=meta-llama/Llama-3.2-3B-Instruct
MISTRAL_MODEL=TheBloke/Mistral-7B-Instruct-v0.2-GPTQ
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# Embeddings — TEI: docker compose embedding-server → :8001
EMBEDDING_BACKEND=tei
EMBEDDING_SERVER_URL=http://localhost:8001
TEI_EMBED_BATCH_SIZE=32
EMBED_TEI_MODEL_ID=BAAI/bge-m3

# Optional — Ollama instead of vLLM/TEI
# LLM_BACKEND=ollama
# EMBEDDING_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# LLAMA_MODEL=llama3:8b
# MISTRAL_MODEL=mistral:7b
# EMBED_MODEL=nomic-embed-text

PAYSIM_CSV_PATH=./data/raw/paysim1.csv
DEV_ROW_LIMIT=500000
LOG_LEVEL=INFO

API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
